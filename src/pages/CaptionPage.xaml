<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage"
    JournalEntry.KeepAlive="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="SectionColumn" Width="320" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="5,5,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </Grid.Resources>

            <!--  Every finished sentence of this class, oldest first.  -->
            <TextBlock
                x:Name="TranscriptEmptyHint"
                Grid.Row="0"
                Margin="6,4,6,0"
                Opacity="0.6"
                Text="开始上课后，每句原文和译文会按顺序列在这里，最新的在最下面。"
                TextWrapping="Wrap" />
            <ScrollViewer
                x:Name="TranscriptScroll"
                Grid.Row="0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,6,6"
                                Padding="10,6,10,8"
                                Opacity="{Binding Opacity}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Cursor="Hand"
                                        FontSize="13"
                                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                        Opacity="0.75"
                                        Text="{Binding SourceText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding DataContext.OriginalVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        ToolTip="单击复制" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Cursor="Hand"
                                        FontSize="16"
                                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                        Text="{Binding TranslatedText}"
                                        TextWrapping="Wrap"
                                        ToolTip="单击复制" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  E.g. LiveCaptions' own translation is on, so the "original" is already Chinese.  -->
            <Border
                Grid.Row="1"
                Margin="0,4,6,0"
                Padding="10,6"
                Background="#33FFB900"
                BorderBrush="#99FFB900"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding SourceWarningVisibility}">
                <TextBlock Text="{Binding SourceWarning}" TextWrapping="Wrap" />
            </Border>

            <!--  The sentence being spoken right now.  -->
            <ui:Card
                Grid.Row="2"
                Margin="0,4,6,0"
                Padding="10,8,10,10"
                VerticalAlignment="Bottom">
                <Grid>
                    <StackPanel>
                        <TextBlock
                            x:Name="OriginalCaption"
                            Background="Transparent"
                            Cursor="Hand"
                            FontSize="15"
                            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                            PreviewMouseWheel="OriginalCard_PreviewMouseWheel"
                            Style="{StaticResource CaptionBlockStyle}"
                            Text="{Binding DisplayOriginalCaption, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="单击复制，Ctrl+滚轮调整字号"
                            Visibility="{Binding OriginalVisibility}" />
                        <TextBlock
                            x:Name="TranslatedCaption"
                            Margin="0,6,0,0"
                            Background="Transparent"
                            Cursor="Hand"
                            FontSize="18"
                            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                            PreviewMouseWheel="TranslatedCard_PreviewMouseWheel"
                            Style="{StaticResource CaptionBlockStyle}"
                            Text="{Binding DisplayTranslatedCaption, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="单击复制，Ctrl+滚轮调整字号" />
                    </StackPanel>
                    <!--  Shown until LiveCaptions produces its first words, so an empty page doesn't look broken.  -->
                    <TextBlock
                        IsHitTestVisible="False"
                        Opacity="0.6"
                        Text="{Binding StatusHint}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DisplayOriginalCaption}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayOriginalCaption}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ui:Card>
        </Grid>

        <!--  Drag to change the width of the two columns.  -->
        <GridSplitter
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            DragCompleted="SectionSplitter_DragCompleted"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ToolTip="拖动调整宽度" />

        <Grid Grid.Column="2" Margin="0,5,15,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="4,2,0,6"
                FontWeight="SemiBold"
                Text="小节总结" />
            <TextBlock
                x:Name="SectionEmptyHint"
                Grid.Row="1"
                Margin="4,0,0,0"
                Opacity="0.6"
                Text="今天还没有小节。开始上课后会自动分节总结，也可以按 Ctrl+Alt+S 手动结束本节。"
                TextWrapping="Wrap" />
            <ScrollViewer
                x:Name="SectionScroll"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,6,6"
                                Padding="10,6,10,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding TimeRange}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Text="{Binding Body}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
