<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:LiveCaptionsTranslator.models"
             x:Class="LiveCaptionsTranslator.CaptionPage">
    <Grid x:Name="Root">
        <Grid.Styles>
            <Style Selector="Border.card">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Padding" Value="10,6,10,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            </Style>
        </Grid.Styles>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="320" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="5,5,0,5" RowDefinitions="*,Auto,Auto">
            <!-- Every finished sentence of this class, oldest first -->
            <TextBlock x:Name="TranscriptEmptyHint" Grid.Row="0" Margin="6,4,6,0" Opacity="0.6"
                       Text="开始上课后，每句原文和译文会按顺序列在这里，最新的在最下面。" TextWrapping="Wrap" />
            <ScrollViewer x:Name="TranscriptScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:HistoryLine">
                            <Border Classes="card" Opacity="{Binding Opacity}">
                                <StackPanel>
                                    <TextBlock Classes="copy original" FontSize="13" Opacity="0.75" Text="{Binding SourceText}"
                                               TextWrapping="Wrap" ToolTip.Tip="单击复制" Cursor="Hand" />
                                    <TextBlock Classes="copy" Margin="0,3,0,0" FontSize="16" Text="{Binding TranslatedText}"
                                               TextWrapping="Wrap" ToolTip.Tip="单击复制" Cursor="Hand" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- A problem with what the recognizer delivers -->
            <Border x:Name="WarningBorder" Grid.Row="1" Margin="0,4,6,0" Padding="10,6" Background="#33FFB900"
                    BorderBrush="#99FFB900" BorderThickness="1" CornerRadius="6" IsVisible="False">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
            </Border>

            <!-- The sentence being spoken right now -->
            <Border Grid.Row="2" Margin="0,4,6,0" Padding="10,8,10,10" VerticalAlignment="Bottom" CornerRadius="6"
                    BorderThickness="1" Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="OriginalCaption" FontSize="15" TextWrapping="Wrap" Cursor="Hand"
                                   ToolTip.Tip="单击复制，Ctrl+滚轮调整字号" />
                        <TextBlock x:Name="TranslatedCaption" Margin="0,6,0,0" FontSize="18" TextWrapping="Wrap"
                                   Cursor="Hand" ToolTip.Tip="单击复制，Ctrl+滚轮调整字号" />
                    </StackPanel>
                    <!-- Shown until the first words arrive, so an empty page doesn't look broken -->
                    <TextBlock x:Name="StatusHint" IsHitTestVisible="False" Opacity="0.6" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- Drag to change the width of the two columns -->
        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="8" Background="Transparent"
                      ToolTip.Tip="拖动调整宽度" />

        <Grid Grid.Column="2" Margin="0,5,15,5" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="4,2,0,6">
                <TextBlock FontWeight="SemiBold" Text="小节总结" />
                <TextBlock x:Name="SummaryStatus" Margin="0,2,0,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
            <TextBlock x:Name="SectionEmptyHint" Grid.Row="1" Margin="4,0,0,0" Opacity="0.6"
                       Text="这节课还没有小节。开始上课后会自动分节总结，也可以按 Ctrl+Alt+S 手动结束本节。"
                       TextWrapping="Wrap" />
            <ScrollViewer x:Name="SectionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:SectionEntry">
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                               Text="{Binding TimeRange}" />
                                    <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
