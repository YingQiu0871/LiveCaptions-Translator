<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LiveCaptionsTranslator"
        x:Class="LiveCaptionsTranslator.OverlayWindow"
        Title="悬浮字幕"
        Icon="/assets/icon.png"
        Width="480" Height="135"
        MinWidth="300" MinHeight="60"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="#FFAAAAAA" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.edge">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="BorderBackground" Margin="5" CornerRadius="8" Background="#80000000">
            <Grid x:Name="CaptionGrid" RowDefinitions="Auto,*">
                <Border x:Name="TranslatedCaptionCard" Grid.Row="0" Margin="5,2" Padding="8" VerticalAlignment="Top">
                    <local:StrokeTextBlock x:Name="TranslatedCaption" />
                </Border>
                <Border x:Name="OriginalCaptionCard" Grid.Row="1" Margin="5,2" Padding="8" VerticalAlignment="Top">
                    <local:StrokeTextBlock x:Name="OriginalCaption" />
                </Border>

                <WrapPanel x:Name="ControlPanel" Grid.Row="1" Margin="0,0,5,5" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" IsVisible="False">
                    <Button x:Name="FontSizeIncrease" Classes="tool" Content="A+" ToolTip.Tip="字号加大" Click="FontIncrease_Click" />
                    <Button x:Name="FontSizeDecrease" Classes="tool" Content="A−" ToolTip.Tip="字号减小" Click="FontDecrease_Click" />
                    <Button x:Name="FontStrokeIncrease" Classes="tool" Content="描+" ToolTip.Tip="描边加粗" Click="FontStrokeIncrease_Click" />
                    <Button x:Name="FontStrokeDecrease" Classes="tool" Content="描−" ToolTip.Tip="描边变细" Click="FontStrokeDecrease_Click" />
                    <Button x:Name="FontBold" Classes="tool" Content="B" FontWeight="Bold" ToolTip.Tip="加粗" Click="FontBold_Click" />
                    <Button x:Name="FontColorCycle" Classes="tool" Content="字色" ToolTip.Tip="文字颜色" Click="FontColorCycle_Click" />
                    <Button x:Name="OpacityIncrease" Classes="tool" Margin="6,1,1,1" Content="深" ToolTip.Tip="背景加深"
                            Click="BackgroundOpacityIncrease_Click" />
                    <Button x:Name="OpacityDecrease" Classes="tool" Content="浅" ToolTip.Tip="背景变浅"
                            Click="BackgroundOpacityDecrease_Click" />
                    <Button x:Name="BackgroundColorCycle" Classes="tool" Content="底色" ToolTip.Tip="背景颜色"
                            Click="BackgroundColorCycle_Click" />
                    <Button x:Name="OnlyModeButton" Classes="tool" Margin="6,1,1,1" Content="全显" ToolTip.Tip="只显示原文或译文"
                            Click="OnlyModeButton_Click" />
                    <Button x:Name="SwitchModeButton" Classes="tool" Content="⇅" ToolTip.Tip="交换原文和译文的上下顺序"
                            Click="SwitchModeButton_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Resize handles on the edges and corners -->
        <Border x:Name="TopEdge" Classes="edge" Height="6" VerticalAlignment="Top" Margin="10,0" Cursor="SizeNorthSouth" />
        <Border x:Name="BottomEdge" Classes="edge" Height="6" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNorthSouth" />
        <Border x:Name="LeftEdge" Classes="edge" Width="6" HorizontalAlignment="Left" Margin="0,10" Cursor="SizeWestEast" />
        <Border x:Name="RightEdge" Classes="edge" Width="6" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWestEast" />
        <Border x:Name="TopLeftEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="TopLeftCorner" />
        <Border x:Name="TopRightEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="TopRightCorner" />
        <Border x:Name="BottomLeftEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Cursor="BottomLeftCorner" />
        <Border x:Name="BottomRightEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Cursor="BottomRightCorner" />
    </Grid>
</Window>
