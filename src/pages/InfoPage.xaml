<Page
    x:Class="LiveCaptionsTranslator.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InfoPage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                <Run Text="课堂同传助手由 @YingQiu0871 基于开源项目 LiveCaptions Translator 改造，增加了课堂分节总结、时间线、双语浮窗、笔记初稿和耳机播报。问题和建议欢迎在本项目的 GitHub Issue 反馈。" />
                <Run Text="&#x0A;如果觉得好用，欢迎给本项目和原项目点个 Star！" />
            </TextBlock>
            <Separator Margin="0,5,0,5" />
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="本项目仓库：" />
                <Hyperlink NavigateUri="https://github.com/YingQiu0871/LiveCaptions-Translator" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="https://github.com/YingQiu0871/LiveCaptions-Translator" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="作者：" />
                <Hyperlink NavigateUri="https://github.com/YingQiu0871" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="@YingQiu0871" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="使用说明：" />
                <Hyperlink NavigateUri="https://github.com/YingQiu0871/LiveCaptions-Translator#readme" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="https://github.com/YingQiu0871/LiveCaptions-Translator#readme" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="原项目仓库：" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="https://github.com/SakiRinn/LiveCaptions-Translator" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="原作者：" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="@SakiRinn" />
                </Hyperlink>
                <Run Text="（作者）和" />
                <Hyperlink NavigateUri="https://github.com/A-nony-mous" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="@A-nony-mous" />
                </Hyperlink>
            </TextBlock>
            <TextBlock>
                <Run FontWeight="SemiBold" Text="版本：" />
                <Hyperlink NavigateUri="https://github.com/YingQiu0871/LiveCaptions-Translator/releases" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run x:Name="Version" Text="1.1.1.1" />
                </Hyperlink>
            </TextBlock>
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="更新：" />
                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateLinkBlock" VerticalAlignment="Center" Visibility="Collapsed">
                    <Hyperlink x:Name="UpdateLink" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run x:Name="UpdateLinkText" />
                    </Hyperlink>
                </TextBlock>
                <ui:Button
                    x:Name="CheckUpdateButton"
                    Margin="12,0,0,0"
                    Padding="10,3"
                    Click="CheckUpdateButton_Click"
                    Content="检查更新" />
            </StackPanel>
            <CheckBox
                x:Name="AutoCheckBox"
                Margin="0,4,0,0"
                Click="AutoCheckBox_Click"
                Content="启动时自动检查更新" />
        </StackPanel>
    </Grid>
</Page>
