<Page
    x:Class="LiveCaptionsTranslator.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TimelinePage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel
                MaxHeight="34.94"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <DatePicker
                    x:Name="DayPicker"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    SelectedDateChanged="DayPicker_SelectedDateChanged" />
                <ui:Button
                    x:Name="EndSection"
                    Margin="8,0,0,0"
                    Click="EndSection_click"
                    Content="结束本节并总结"
                    Icon="{ui:SymbolIcon Flag16,
                                         Filled=False}"
                    ToolTip="Ctrl+Alt+S" />
                <ui:Button
                    x:Name="LoadSlides"
                    Margin="8,0,0,0"
                    Click="LoadSlides_click"
                    Content="上传课件"
                    Icon="{ui:SymbolIcon DocumentPdf16,
                                         Filled=False}"
                    ToolTip="载入后按课件页码分节" />
                <ui:Button
                    x:Name="ClearSlides"
                    Margin="3,0,0,0"
                    Appearance="Transparent"
                    Click="ClearSlides_click"
                    Icon="{ui:SymbolIcon Dismiss12,
                                         Filled=False}"
                    ToolTip="移除课件"
                    Visibility="Collapsed" />
                <ui:TextBlock
                    x:Name="SlidesInfo"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.75" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                MaxHeight="34.94"
                Margin="3,0,3,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="Export"
                    Appearance="Transparent"
                    Click="Export_click"
                    Icon="{ui:SymbolIcon ArrowDown12,
                                         Filled=False}"
                    MouseOverBackground="#07000000"
                    ToolTip="导出当天笔记 (Markdown)" />
                <ui:Button
                    x:Name="Refresh"
                    Margin="5,0,0,0"
                    Appearance="Transparent"
                    Click="Refresh_click"
                    Icon="{ui:SymbolIcon ArrowClockwise12,
                                         Filled=False}"
                    MouseOverBackground="#07000000"
                    ToolTip="刷新" />
            </StackPanel>
        </Grid>

        <ui:TextBlock
            x:Name="EmptyHint"
            Grid.Row="1"
            Margin="5,15,5,0"
            Opacity="0.7"
            Text="还没有小节总结。开始上课后，每隔几分钟会自动生成一节，也可以随时按 Ctrl+Alt+S 手动结束本节。"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ScrollViewer
            x:Name="SectionScroll"
            Grid.Row="1"
            Margin="0,8,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,10,8"
                            Padding="12,8,12,10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding TimeRange}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="{Binding Body}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
