<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveCaptionsTranslator.MainWindow"
        Title="课堂同传助手"
        Icon="/assets/icon.png"
        Width="900" Height="560"
        MinWidth="750" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*">
        <!-- Top bar: class controls -->
        <Border Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <StackPanel.Styles>
                    <Style Selector="Button, ToggleButton">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </StackPanel.Styles>
                <Button x:Name="StartButton" Classes="accent" Content="开始" MinWidth="76"
                        ToolTip.Tip="开始 / 停止上课" Click="StartButton_Click" />
                <Button Content="结束本节"
                        ToolTip.Tip="结束本节并总结 (Ctrl+Alt+S)" Click="EndSectionButton_Click" />
                <StackPanel Orientation="Horizontal" Margin="4,0,6,0" VerticalAlignment="Center" Spacing="4"
                            ToolTip.Tip="打开 / 关闭耳机播报 (Ctrl+Alt+M)">
                    <TextBlock Text="耳机播报" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="SpeechSwitch" OnContent="{x:Null}" OffContent="{x:Null}"
                                  VerticalAlignment="Center" Click="SpeechSwitch_Click" />
                </StackPanel>
                <ToggleButton x:Name="LogOnlyButton" Content="暂停翻译"
                              ToolTip.Tip="暂停翻译（只记录原文）" Click="LogOnlyButton_Click" />
                <ToggleButton x:Name="OverlayModeButton" Content="悬浮字幕"
                              ToolTip.Tip="悬浮字幕窗" Click="OverlayModeButton_Click" />
                <ToggleButton x:Name="BilingualModeButton" Content="双语浮窗"
                              ToolTip.Tip="双语浮窗（原文 + 译文，半透明置顶）" Click="BilingualModeButton_Click" />
                <ToggleButton x:Name="TopmostButton" Content="置顶"
                              ToolTip.Tip="窗口置顶" Click="TopmostButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <ListBox x:Name="NavList" Grid.Column="0" Width="88" Padding="4,8"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0,10" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <Grid Grid.Column="1">
                <ContentControl x:Name="PageHost" />

                <!-- Notifications of the core -->
                <Border x:Name="Toast" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16" Padding="14,10" CornerRadius="6" MinWidth="260" MaxWidth="560"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ToastMessage" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="ToastClose" Grid.Column="1" Padding="8,6" Margin="10,0,0,0"
                                VerticalAlignment="Top" Background="Transparent" Click="ToastClose_Click">
                            <!-- Drawn, not a "✕" character: not every Linux font has that glyph. -->
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter}}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
