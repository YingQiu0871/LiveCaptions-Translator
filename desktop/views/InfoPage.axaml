<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LiveCaptionsTranslator.InfoPage">
    <StackPanel Margin="10" Spacing="4">
        <TextBlock TextWrapping="Wrap"
                   Text="课堂同传助手由 @YingQiu0871 基于开源项目 LiveCaptions Translator 改造，增加了课堂分节总结、时间线、双语浮窗、笔记初稿和耳机播报。问题和建议欢迎在本项目的 GitHub Issue 反馈。&#x0A;如果觉得好用，欢迎给本项目和原项目点个 Star！" />
        <Separator Margin="0,5,0,5" />
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="本项目仓库：" VerticalAlignment="Center" />
            <HyperlinkButton Padding="0" Content="https://github.com/YingQiu0871/LiveCaptions-Translator"
                             NavigateUri="https://github.com/YingQiu0871/LiveCaptions-Translator" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="作者：" VerticalAlignment="Center" />
            <HyperlinkButton Padding="0" Content="@YingQiu0871"
                             NavigateUri="https://github.com/YingQiu0871" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="使用说明：" VerticalAlignment="Center" />
            <HyperlinkButton Padding="0" Content="https://github.com/YingQiu0871/LiveCaptions-Translator#readme"
                             NavigateUri="https://github.com/YingQiu0871/LiveCaptions-Translator#readme" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="原项目仓库：" VerticalAlignment="Center" />
            <HyperlinkButton Padding="0" Content="https://github.com/SakiRinn/LiveCaptions-Translator"
                             NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="原作者：" VerticalAlignment="Center" />
            <HyperlinkButton Padding="0" Content="@SakiRinn" NavigateUri="https://github.com/SakiRinn" />
            <TextBlock Text="（作者）和" VerticalAlignment="Center" />
            <HyperlinkButton Padding="0" Content="@A-nony-mous" NavigateUri="https://github.com/A-nony-mous" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold" Text="版本：" VerticalAlignment="Center" />
            <HyperlinkButton x:Name="Version" Padding="0" Content="1.1.1.1"
                             NavigateUri="https://github.com/YingQiu0871/LiveCaptions-Translator/releases" />
        </StackPanel>
    </StackPanel>
</UserControl>
