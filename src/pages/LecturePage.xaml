<Page
    x:Class="LiveCaptionsTranslator.LecturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LecturePage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,4" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <Grid Margin="15,12,5,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Left column: model / API, slides  -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="⓪ 输入源" />

                        <TextBlock Style="{StaticResource Label}" Text="听哪里的声音" />
                        <ComboBox x:Name="SourceBox" SelectionChanged="SourceBox_SelectionChanged">
                            <ComboBoxItem Content="电脑播放的声音（网课、视频）" />
                            <ComboBoxItem Content="麦克风（线下教室）" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="麦克风" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                x:Name="MicBox"
                                MinWidth="230"
                                SelectionChanged="MicBox_SelectionChanged" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Click="RefreshDevices_click"
                                Icon="{ui:SymbolIcon ArrowClockwise12,
                                                     Filled=False}"
                                ToolTip="刷新设备列表" />
                        </StackPanel>
                        <TextBlock x:Name="SourceStatus" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}" Text="选择麦克风会把它设为 Windows 默认录音设备，并重启实时字幕。不要选蓝牙耳机自带的麦克风，否则耳机会切换到通话模式，音质变差。" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                x:Name="LiveCaptionsButton"
                                Click="LiveCaptionsButton_click"
                                Content="显示系统实时辅助字幕"
                                Icon="{ui:SymbolIcon ClosedCaption16,
                                                     Filled=False}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="用来检查系统字幕有没有出字、修改源语言或首次下载语音识别文件。用完点“隐藏”，不要直接关掉它。" />
                    </StackPanel>
                </Border>

                <Border x:Name="ApiCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="① 模型与 API" />

                        <TextBlock Style="{StaticResource Label}" Text="服务商" />
                        <ComboBox x:Name="ProviderBox" SelectionChanged="ProviderBox_SelectionChanged">
                            <ComboBoxItem Content="DeepSeek" />
                            <ComboBoxItem Content="通义千问（阿里云百炼）" />
                            <ComboBoxItem Content="其他 OpenAI 兼容接口" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="API 地址" />
                        <ui:TextBox
                            x:Name="ApiUrlBox"
                            PlaceholderText="https://…/chat/completions"
                            Text="{Binding ApiUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource Label}" Text="API Key" />
                        <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
                        <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Hint}" />

                        <TextBlock Style="{StaticResource Label}" Text="模型（可从列表选，也可以直接输入）" />
                        <ComboBox
                            x:Name="ModelBox"
                            IsEditable="True"
                            Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource Hint}" Text="小节总结始终用这里的模型；翻译用哪个接口在“⑤ 翻译”里选。" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                x:Name="TestApiButton"
                                Click="TestApi_click"
                                Content="测试连接"
                                Icon="{ui:SymbolIcon PlugConnected20,
                                                     Filled=False}" />
                            <TextBlock
                                x:Name="TestApiResult"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="② 课件（可选）" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                x:Name="LoadSlidesButton"
                                Click="LoadSlides_click"
                                Content="上传课件 PDF"
                                Icon="{ui:SymbolIcon DocumentPdf16,
                                                     Filled=False}" />
                            <ui:Button
                                x:Name="ClearSlidesButton"
                                Margin="6,0,0,0"
                                Click="ClearSlides_click"
                                Content="移除"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SlidesInfo"
                            Margin="2,8,0,0"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Label}" Text="扫描版课件的 OCR 语言" />
                        <ComboBox x:Name="OcrLanguageBox" SelectionChanged="OcrLanguageBox_SelectionChanged" />
                        <ui:ToggleSwitch
                            Margin="0,8,0,0"
                            Content="所有页面都用 OCR（文字乱码时打开）"
                            IsChecked="{Binding ForceOcr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="上传后按老师讲到的页码分节，小结也会参考这一页的文字纠正术语。没有文字的页面（扫描件、图片）会自动用 Windows 自带的 OCR 识别；OCR 语言来自 Windows 已安装的语言包。也支持 .pptx。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Right column: sections, speech  -->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="③ 分节总结" />
                        <ui:ToggleSwitch
                            Content="自动分节并总结"
                            IsChecked="{Binding SummaryEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}" Text="分节方式" />
                        <ComboBox SelectedIndex="{Binding SegmentModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="自动：按课件页码 / 话题变化" />
                            <ComboBoxItem Content="固定按时间" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" ToolTip="自动模式下，同一话题讲了这么久也会强制分一节">
                            <Run Text="每节最长：" />
                            <Run Text="{Binding MaxSectionMinutes, Mode=OneWay}" />
                            <Run Text="分钟" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="20"
                            Minimum="2"
                            TickFrequency="1"
                            Value="{Binding MaxSectionMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}" ToolTip="固定按时间模式，或自动识别失败时使用">
                            <Run Text="按时间分节：每" />
                            <Run Text="{Binding SummaryIntervalMinutes, Mode=OneWay}" />
                            <Run Text="分钟一节" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="15"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding SummaryIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="随时按 Ctrl+Alt+S 可手动结束本节。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="④ 耳机播报" />

                        <TextBlock Style="{StaticResource Label}" Text="读出内容" />
                        <ComboBox SelectedIndex="{Binding SpeakModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="关闭" />
                            <ComboBoxItem Content="只读小节总结" />
                            <ComboBoxItem Content="小节总结 + 每句译文" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="输出设备" />
                        <ComboBox x:Name="SpeechDeviceBox" SelectionChanged="SpeechDeviceBox_SelectionChanged" />
                        <TextBlock x:Name="SpeechDeviceHint" Style="{StaticResource Hint}" />

                        <TextBlock Style="{StaticResource Label}" Text="语音" />
                        <ComboBox x:Name="VoiceBox" SelectionChanged="VoiceBox_SelectionChanged" />

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="语速：" />
                            <Run Text="{Binding SpeechRate, Mode=OneWay}" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="-5"
                            TickFrequency="1"
                            Value="{Binding SpeechRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="音量：" />
                            <Run Text="{Binding SpeechVolume, Mode=OneWay}" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="10"
                            TickFrequency="5"
                            Value="{Binding SpeechVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                Click="TestSpeech_click"
                                Content="试听"
                                Icon="{ui:SymbolIcon Play16,
                                                     Filled=False}" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Click="SoundSettings_click"
                                Content="选择输出设备…"
                                Icon="{ui:SymbolIcon Speaker216,
                                                     Filled=False}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="标题栏的“耳机播报”开关或 Ctrl+Alt+M 可以随时打开 / 关闭。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Full width: translation  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="⑤ 翻译" />

                        <TextBlock Style="{StaticResource Label}" Text="翻译接口" />
                        <ComboBox
                            x:Name="TranslateApiBox"
                            DisplayMemberPath="Name"
                            SelectionChanged="TranslateApiBox_SelectionChanged" />
                        <TextBlock Style="{StaticResource Hint}" Text="选 DeepSeek / 通义千问时使用“① 模型与 API”的设置；Google 免费，不用 Key。" />

                        <TextBlock Style="{StaticResource Label}" Text="翻译成" />
                        <ComboBox
                            x:Name="TargetLangBox"
                            IsEditable="True"
                            LostFocus="TargetLangBox_LostFocus"
                            SelectionChanged="TargetLangBox_SelectionChanged" />
                        <TextBlock Style="{StaticResource Hint}" Text="可以直接输入语言代码，例如 zh-CN、en-US。" />

                        <ui:Button
                            Margin="0,10,0,0"
                            Click="APISettingButton_click"
                            Content="其他接口的配置…"
                            Icon="{ui:SymbolIcon Settings16,
                                                 Filled=False}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <ui:ToggleSwitch
                            Margin="0,34,0,0"
                            Content="中外对照（译文上方保留原文）"
                            IsChecked="{Binding ShowOriginal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="结合上下文翻译（更准确，多用一些 token）"
                            IsChecked="{Binding ContextAware, Source={x:Static local:Translator.Setting}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="显示翻译用时"
                            IsChecked="{Binding MainWindow.LatencyShow, Source={x:Static local:Translator.Setting}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="翻译频率：字幕每变化" />
                            <Run Text="{Binding MaxSyncInterval, Source={x:Static local:Translator.Setting}, Mode=OneWay}" />
                            <Run Text="次翻译一次" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding MaxSyncInterval, Source={x:Static local:Translator.Setting}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="数值越小翻得越及时，调用接口也越频繁。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Full width: prompt  -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource Card}">
                <Expander Header="高级：总结提示词">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Hint}" Text="{}{0} 会被替换为目标语言。" />
                        <ui:TextBox
                            MinHeight="90"
                            Margin="0,6,0,0"
                            AcceptsReturn="True"
                            Text="{Binding SummaryPrompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,6,0,0"
                            Click="ResetPrompt_click"
                            Content="恢复默认" />
                    </StackPanel>
                </Expander>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
